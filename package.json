{
  "name": "latex-word-studio",
  "version": "0.6.11",
  "description": "Ứng dụng desktop cục bộ (macOS và Windows) để soạn văn bản, LaTeX, Word và PDF.",
  "author": "Viet LaTeX Studio",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run backend:build && node scripts/run-web.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "test:spellcheck": "node --test scripts/spellcheck.test.mjs scripts/spellcheck-segments.test.mjs scripts/latex-spellcheck.test.mjs electron/spellcheck-store.test.cjs",
    "test:ai": "node --test electron/gemini.test.cjs scripts/ai-selection.test.mjs",
    "test:ai:desktop": "node scripts/build-desktop.mjs && node scripts/ai-desktop.mjs",
    "test:spellcheck:ui": "node scripts/spellcheck-ui.mjs",
    "check": "npm run lint && npm run test:spellcheck && npm run test:ai && npm run test:go && npm run test:backend && npm run test:sync && npm run test:updater && npm run test:upgrade && npm run build",
    "test:spellcheck:bench": "node scripts/spellcheck-bench.mjs",
    "test:spellcheck:desktop": "npm run backend:build && node scripts/spellcheck-desktop.mjs",
    "check:full": "node scripts/check-full.mjs",
    "preview": "npm run backend:build && node scripts/run-web.mjs --preview",
    "backend:build": "node scripts/build-backend.mjs",
    "test:backend": "npm run backend:build && node --test scripts/bibliography.test.mjs scripts/project-assets.test.mjs scripts/latex-compiler.test.mjs scripts/electron-proxy.test.mjs scripts/citation-linker.test.mjs scripts/citation-review.test.mjs scripts/document-data.test.mjs scripts/service-roundtrip-regressions.test.mjs scripts/document-reference-validation.test.js scripts/project-compilation.test.mjs scripts/document-serializer.test.mjs scripts/math-input.test.mjs scripts/formula-recognition.test.mjs scripts/math-suggestion-scanner.test.mjs scripts/math-node-transforms.test.mjs scripts/upgrade-snapshot.test.mjs scripts/rich-text.test.mjs scripts/external-links.test.mjs scripts/untrusted-latex-trust.test.mjs scripts/pdf-compile-scheduler.test.mjs scripts/table-styles.test.mjs scripts/table-note-content.test.mjs electron/app-protocol.test.cjs electron/backend-client.test.cjs electron/workspace-store.test.cjs electron/mac/environment.test.cjs electron/win/environment.test.cjs electron/win/firewall.test.cjs",
    "smoke:latex": "npm run backend:build && node scripts/smoke-latex.mjs",
    "smoke:math-paste": "node scripts/smoke-math-paste.mjs",
    "desktop:dev": "node scripts/run-desktop-dev.mjs",
    "desktop:preview": "node scripts/run-desktop.mjs",
    "desktop:build:dir": "node mac/build-mac.mjs --dir",
    "desktop:build": "node scripts/build-current-platform.mjs",
    "desktop:build:mac": "node mac/build-mac.mjs",
    "desktop:verify:mac": "node mac/verify-mac-package.mjs",
    "desktop:update:local": "node mac/install-mac-local.mjs",
    "test:sync": "node --test electron/lan-sync.test.cjs electron/project-sync.test.cjs electron/sync-relay.test.cjs",
    "sync:relay": "node electron/sync-relay-server.cjs",
    "test:sync:internet:desktop": "node scripts/project-sync-desktop.mjs",
    "test:updater": "node --test electron/updater.test.cjs scripts/bump-version.test.mjs mac/application-swap.test.mjs",
    "release:patch": "node scripts/bump-version.mjs patch --commit",
    "release:minor": "node scripts/bump-version.mjs minor --commit",
    "release:major": "node scripts/bump-version.mjs major --commit",
    "test:sync:desktop": "node scripts/lan-sync-desktop.mjs",
    "test:quit-failure": "node scripts/quit-failure-desktop.mjs",
    "test:pdf-batching": "npm run backend:build && node scripts/pdf-batching-smoke.mjs",
    "test:load": "npm run backend:build && node scripts/load-compile.mjs",
    "setup:pandoc": "node mac/setup-pandoc.mjs",
    "setup:pandoc:win": "node win/setup-pandoc.mjs",
    "test:upgrade": "npm run backend:build && node --test scripts/upgrade.test.mjs",
    "test:desktop": "npm run backend:build && node scripts/desktop-smoke.mjs",
    "test:ui": "node scripts/monochrome-ui-smoke.mjs",
    "test:document-frame": "node --test scripts/document-frame.test.mjs && node scripts/document-frame-ui.mjs",
    "test:math-keyboard": "node scripts/math-keyboard-ui.mjs",
    "test:shortcuts": "node --test scripts/keyboard-shortcuts.test.mjs && node scripts/keyboard-shortcuts-ui.mjs",
    "test:shortcuts:desktop": "node scripts/build-desktop.mjs && node scripts/keyboard-shortcuts-desktop.mjs",
    "test:project-tabs": "node scripts/project-tabs-ui.mjs",
    "test:project-pdf": "npm run backend:build && node scripts/project-compilation-pdf.mjs",
    "test:desktop:dist": "node scripts/build-desktop.mjs && cross-env VIETLATEX_TEST_PACKAGED_RENDERER=true node scripts/desktop-smoke.mjs",
    "test:headings": "node scripts/build-desktop.mjs && node scripts/heading-numbering-desktop.mjs",
    "test:stress": "npm run backend:build && node scripts/stress-backend.mjs",
    "smoke:serializer": "npm run backend:build && node scripts/smoke-serializer-xelatex.mjs",
    "test:go": "cd backend && go vet ./... && go test ./...",
    "test:go:race": "cd backend && go test -race -count=1 ./...",
    "test:bench": "npm run backend:build && node scripts/bench-compile.mjs",
    "test:citation-scan": "node --test scripts/citation-linker.test.mjs scripts/citation-review.test.mjs && node scripts/citation-linker-ui.mjs && node scripts/citation-screenshot-ui.mjs",
    "test:review-fixes": "node scripts/review-fixes-ui.mjs",
    "setup:tex": "node mac/setup-tex.mjs",
    "test:mac": "node --test electron/mac/environment.test.cjs",
    "test:win": "node --test electron/win/environment.test.cjs electron/win/firewall.test.cjs",
    "test:packaged:mac": "node mac/mac-packaged-smoke.mjs",
    "test:dark-text": "node scripts/build-desktop.mjs && node scripts/dark-text-pdf-desktop.mjs",
    "test:table-deletion:ui": "node scripts/table-deletion-ui.mjs",
    "test:preview-layout": "node scripts/preview-layout-desktop.mjs",
    "backend:build:windows": "node scripts/build-backend.mjs",
    "desktop:build:win": "node win/build-win.mjs",
    "desktop:build:win:dir": "node win/build-win.mjs --dir",
    "test:bench:cache": "npm run backend:build && node scripts/bench-cache.mjs",
    "test:word:roundtrip": "npm run backend:build && node scripts/word-roundtrip-regressions.mjs",
    "test:table-math-rendering": "npm run backend:build && node scripts/table-math-rendering.mjs",
    "test:table-note-math": "node scripts/table-note-math-ui.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "mathlive": "^0.110.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.14.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "vn.vietlatex.studio",
    "productName": "Viet Latex Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/services/*.js",
      "src/math-input.js",
      "src/unicode-scripts.js",
      "package.json",
      "!electron/**/*.test.cjs",
      "!node_modules/@napi-rs/canvas/**",
      "!node_modules/@napi-rs/canvas-*/**"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
